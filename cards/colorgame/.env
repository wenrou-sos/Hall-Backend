# 時間單位 MilliSecond = 1/1000 秒
# 下注回合秒數
BET_ROUND_COUNTDOWN_TIME = 15000

# 時間單位 MilliSecond = 1/1000 秒
# 搖骰秒數
ROLL_DICE_TIME = 6000

# 時間單位 MilliSecond = 1/1000 秒
# 開骰秒數
ROUND_END_WAITING_TIME = 13500

# 各大廳預開遊戲室數量
BOTROOM_ROOM_NUM = 10

# BOTROOM_BOT_NUM: 0 ~ 10
# 預開遊戲室機器人數量、每間房間最少人數
#
# Example:
# 	BOTROOM_BOT_NUM = 6
#	若房間人數為 4 時，因為小於最少人數 6 所以會補 2 個機器人進房間
#	若大於 6 時則不會再補機器人
BOTROOM_BOT_NUM = 6